# ============================================================================
# tank_art.gd — силуэты корпусов и камуфляжи.
#
# Раньше все танки рисовались одним прямоугольником 24×28, и разведчик
# отличался от босса только цветом. Цвет читается плохо: в бою, на тёмной
# карте, сквозь дым и погоду. Силуэт читается всегда — поэтому у каждой роли
# теперь свой корпус, своя ходовая и свой ствол.
#
# Размеры отсюда идут не только в отрисовку, но и в физику: ширина и высота
# становятся хитбоксом танка, а радиус попадания считается из них. Иначе
# огромный босс ловил бы пули той же коробкой 24×28, что и разведчик, и
# силуэт врал бы игроку.
# ============================================================================
class_name TankArt
extends RefCounted

## Геометрия корпуса.
##   w, h        — корпус целиком (он же хитбокс)
##   track_w     — ширина гусеницы
##   wheels      — опорных катков на борт
##   nose        — доля высоты, уходящая в скос лобовой брони
##   turret_r    — радиус башни
##   barrel_len  — вылет ствола за край башни. Считается так, чтобы срез
##                 выходил ЗА КОРПУС: ствол, кончающийся внутри габарита,
##                 читается как обрубок
##   muzzle      — plain | brake | tube | twin
##   plates      — накладные бронелисты по бортам
##   antenna     — антенна на корме
##   scope       — прицел на башне
##   stripes     — предупреждающие полосы (босс)
static var CHASSIS := {
	"standard": {
		"w": 24.0, "h": 28.0, "track_w": 6.0, "wheels": 4, "nose": 0.22,
		"turret_r": 7.5, "barrel_len": 24.0, "barrel_w": 5.0, "muzzle": "plain",
		"plates": false, "antenna": false, "scope": false, "stripes": false,
	},
	# Разведчик: маленький, узкий, с высоким скосом — выглядит быстрым
	# и действительно труднее ловит пули.
	"light": {
		"w": 21.0, "h": 25.0, "track_w": 5.0, "wheels": 3, "nose": 0.34,
		"turret_r": 6.0, "barrel_len": 21.0, "barrel_w": 4.0, "muzzle": "plain",
		"plates": false, "antenna": true, "scope": false, "stripes": false,
	},
	# Громила: широкий, почти без скоса, с накладной бронёй и коротким
	# толстым стволом.
	"heavy": {
		"w": 29.0, "h": 30.0, "track_w": 8.0, "wheels": 5, "nose": 0.12,
		"turret_r": 9.5, "barrel_len": 23.0, "barrel_w": 7.5, "muzzle": "brake",
		"plates": true, "antenna": false, "scope": false, "stripes": false,
	},
	# Снайпер: обычный корпус, но ствол в полтора раза длиннее любого другого.
	# По одному этому силуэту видно, что стоять к нему боком не стоит.
	"sniper": {
		"w": 23.0, "h": 29.0, "track_w": 5.5, "wheels": 4, "nose": 0.26,
		"turret_r": 7.0, "barrel_len": 36.0, "barrel_w": 4.0, "muzzle": "brake",
		"plates": false, "antenna": false, "scope": true, "stripes": false,
	},
	# Миномёт: короткая толстая труба вместо ствола.
	"mortar": {
		"w": 25.0, "h": 27.0, "track_w": 6.5, "wheels": 4, "nose": 0.10,
		"turret_r": 8.5, "barrel_len": 14.0, "barrel_w": 10.0, "muzzle": "tube",
		"plates": false, "antenna": true, "scope": false, "stripes": false,
	},
	# Босс: крупнее всех в полтора раза, спаренные стволы, полосы.
	"boss": {
		"w": 34.0, "h": 36.0, "track_w": 9.0, "wheels": 5, "nose": 0.16,
		"turret_r": 11.5, "barrel_len": 30.0, "barrel_w": 6.0, "muzzle": "twin",
		"plates": true, "antenna": true, "scope": false, "stripes": true,
	},
}

## Предел габарита для рельефа: переулки в городе бывают шириной в один тайл
## (32 px), и корпус шире просто не пролезет, а маршрут через него построится.
const MAX_COLLIDE_W := 26.0
const MAX_COLLIDE_H := 30.0

static func chassis(id: String) -> Dictionary:
	return CHASSIS.get(id, CHASSIS["standard"])

## Откуда вылетает снаряд. Не с самого среза: длинный ствол снайпера выходил
## бы за половину корпуса на два десятка пикселей, и стрельба вплотную к стене
## рождала бы снаряды уже внутри неё. Точка ограничена габаритом корпуса.
static func muzzle_len(shape: Dictionary) -> float:
	var tip: float = float(shape["turret_r"]) * 0.5 + float(shape["barrel_len"]) * 0.85
	return minf(tip, float(shape["h"]) * 0.5 + 6.0)

## Радиус попадания пули. Для стандартного корпуса даёт ровно прежние 14 px,
## поэтому баланс обычного боя не поехал — изменились только те танки,
## у которых изменился и силуэт.
static func hit_radius(w: float, h: float) -> float:
	return (w + h) * 0.25 + 1.0
