# ============================================================================
# tile_bake_view.gd — тайлы карты, отрисованные в текстуру заранее.
#
# Наследник WorldView, а не отдельный класс с нуля: _draw_tiles() и всё, что
# ей нужно (кэш локации, класс дороги, фонари), уже есть в родителе, и здесь
# просто вызывается тот же код на весь мир, а не на видимый игроку кусок.
# Это тот же приём, что для реальных танков вне боя (menu_tank_view.gd) —
# рисовать чужим методом «извне» нельзя, только унаследовав его.
#
# Живёт внутри SubViewport (заводит и обновляет WorldView.gd), а не рисует
# каждый кадр сама: WorldView решает, когда карте пора перезалиться.
# ============================================================================
class_name TileBakeView
extends WorldView

func _ready() -> void:
	# Та же фильтрация, что у обычного WorldView (см. её _ready()) — на
	# случай, если какой-то из тайловых слоёв сам рисует текстурой.
	texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR

## У обычного WorldView это queue_redraw() каждый кадр; здесь перерисовка —
## по явному вызову извне (см. WorldView._update_tile_cache()), а не по
## таймеру, иначе кэш обесценился бы собственной же перерисовкой.
func _process(_delta: float) -> void:
	pass

func _draw() -> void:
	if world == null:
		return
	_view = Rect2(0.0, 0.0, world.map.width, world.map.height)
	draw_set_transform(Vector2.ZERO)
	_draw_tiles()
