# ============================================================================
# spatial_grid.gd — пространственная сетка танков для запросов «кто рядом».
#
# _separate_tanks, _try_ram, count_nearby и Bullet._hit_tanks/_explode — по
# сути один и тот же вопрос «какие танки в радиусе R от точки», заданный
# честным перебором всех танков. При 40 танках и полном взаимном
# противостоянии («Царь горы» — там у каждого бота свой team, значит все
# против всех) это самая частая пара вложенных циклов за тик.
#
# Сетка перестраивается заново каждый тик (дёшево — O(n) вставок, без
# инкрементальных обновлений) и отвечает на «кто рядом» перебором содержимого
# нескольких ближайших ячеек вместо всех танков разом. Ячейки крупнее
# тайла карты — при разбросе радиусов от 18 px (попадание пули) до 400 px
# (счёт танков поблизости в бою) мельче смысла нет: для дальних запросов
# пришлось бы обходить слишком много ячеек, а для ближних выигрыш и так
# есть на любом разумном размере.
# ============================================================================
class_name SpatialGrid
extends RefCounted

const CELL := 96.0

var _cells := {}   # Vector2i -> Array[Tank]

static func _key(x: float, y: float) -> Vector2i:
	return Vector2i(int(floor(x / CELL)), int(floor(y / CELL)))

## Перестраивает сетку по текущим позициям живых танков. Мёртвые сюда не
## попадают — их и так пропускает каждый из потребителей отдельной
## проверкой, но не тратить на них ячейку дешевле.
func rebuild(tanks: Array) -> void:
	_cells.clear()
	for t in tanks:
		if not t.alive:
			continue
		var k := _key(t.x, t.y)
		if _cells.has(k):
			_cells[k].append(t)
		else:
			_cells[k] = [t]

## Все танки в квадрате ячеек вокруг точки, покрывающем радиус r. Это
## верхняя оценка — квадрат ячеек шире окружности радиуса r по углам,
## поэтому вызывающий код всё равно обязан сам проверить точное расстояние
## (как он уже делал при переборе всех танков), просто на заметно меньшем
## числе кандидатов.
func query(x: float, y: float, r: float) -> Array:
	var out := []
	var span := int(ceil(r / CELL)) + 1
	var kx := int(floor(x / CELL))
	var ky := int(floor(y / CELL))
	for dx in range(-span, span + 1):
		for dy in range(-span, span + 1):
			var cell = _cells.get(Vector2i(kx + dx, ky + dy))
			if cell != null:
				out.append_array(cell)
	return out
