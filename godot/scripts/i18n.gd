	"perk.double_shot.name": "Double Shot",
	"perk.double_shot.desc": "Fires a volley of two parallel shells at 60% damage each (x1.2 total). Easier to land hits in a straight line.",
	"perk.fan_shot.name": "Fan Shot",
	"perk.fan_shot.desc": "Fires a fan of 3 shells (each dealing 45% damage), sweeping a broad cone ahead.",
	"perk.rapid_fire.name": "Rapid Fire",
	"perk.rapid_fire.desc": "Cuts reload time by 40% and reduces heat generation per shot by 30%.",
	"perk.quick_reload.name": "Quick Reload",
	"perk.quick_reload.desc": "Cuts reload time by 20% and reduces heat per shot by 45% for prolonged sustained fire.",
	"perk.explosive.name": "Explosive Shells",
	"perk.explosive.desc": "A shell that hits a tank detonates, dealing 50% area damage to nearby targets. Standard cannon only.",
	"perk.piercing.name": "Armor-Piercing",
	"perk.piercing.desc": "Hardened penetrator punches through the first wall or obstacle and keeps flying.",
	"perk.heavy_armor.name": "Reinforced Armor",
	"perk.heavy_armor.desc": "Heavy armored plates permanently increase maximum health by 50%.",
	"perk.regen.name": "Regeneration",
	"perk.regen.desc": "Automated nano-repair systems restore 1 HP per second (60 HP per minute).",
	"perk.reflect.name": "Reactive Armor",
	"perk.reflect.desc": "Reactive plating returns 45% of incoming damage to the attacker and stuns them for 0.8 seconds.",
	"perk.evasion.name": "Evasion",
	"perk.evasion.desc": "Quick reactive dodging provides a 15% chance to completely negate any enemy hit.",
	"perk.shield.name": "Energy Shield",
	"perk.shield.desc": "Absorbs up to 30 damage before hull armor is touched. Recharges every 30 seconds.",
	"perk.sprinter.name": "Sprinter",
	"perk.sprinter.desc": "Forced engine tuning increases maximum tank movement speed by 25%.",
	"perk.mines.name": "Minelayer",
	"perk.mines.desc": "Allows laying explosive landmines under the tank (up to 3 active, each lasts 10 seconds).",
	"perk.lightning_lord.name": "Lightning Lord",
	"perk.lightning_lord.desc": "During thunderstorms, lightning strikes the nearest enemy tank with a 25% chance.",
	"perk.ram.name": "Battering Ram",
	"perk.ram.desc": "Doubles ramming damage when you collide with enemy tanks at speed.",
	"perk.ram.challenge": "Destroy 3 tanks by ramming",
	"perk.thick_armor.name": "Solid Plating",
	"perk.thick_armor.desc": "Reduces all incoming damage by 20%, but standard shells can no longer break bricks.",
	"perk.thick_armor.challenge": "Break 15 brick walls",
	"perk.amphibious.name": "Amphibian",
	"perk.amphibious.desc": "Allows traversing water bodies without suffering hull drowning damage.",
	"perk.amphibious.challenge": "Drive into water 5 times",
	"perk.forest.name": "Forest Ranger",
	"perk.forest.desc": "Your tracks no longer fell trees and foliage as you drive through, so the forest stays cover for ambushes.",
