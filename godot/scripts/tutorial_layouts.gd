static func layout(stage: int) -> Array:
	return STAGES.get(stage, [])

static func tile_for(ch: String) -> int:
	return int(TILES.get(ch, Cfg.T_EMPTY))

static func markers(stage: int, ch: String) -> Array:
	var out := []
	var rows: Array = layout(stage)
	for r in rows.size():
		var line: String = rows[r]
		for c in line.length():
			if line[c] == ch:
				out.append(Vector2(float(c) * Cfg.TILE + Cfg.TILE * 0.5, float(r) * Cfg.TILE + Cfg.TILE * 0.5))
	return out
